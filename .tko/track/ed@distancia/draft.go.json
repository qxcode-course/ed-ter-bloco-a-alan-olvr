            "label": "2026-05-26_00-16-24",
            "content": "package main\n\nimport \"fmt\"\n\nfunc valido(seq []byte, pos, L int) bool {\n\tif pos == len(seq) {\n\t\treturn true\n\t}\n\n\tif seq[pos] != '.' {\n\t\treturn valido(seq, pos+1, L)\n\t}\n\n\tfor k := 0; k <= L; k++ {\n\t\tchar := byte('0' + k)\n\n\t\tok := true\n\n\t\tfor j := 0; j < len(seq); j++ {\n\t\t\tif seq[j] == char {\n\t\t\t\tdist := pos - j\n\t\t\t\tif dist < 0 {\n\t\t\t\t\tdist = -dist\n\t\t\t\t}\n\n\t\t\t\tif dist <= L {\n    \t\t\t\tok = false\n   \t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tif ok {\n\t\t\tseq[pos] = char\n\n\t\t\tif valido(seq, pos+1, L) {\n\t\t\t\treturn true\n\t\t\t}\n\n\t\t\tseq[pos] = '.'\n\t\t}\n\t}\n\n\treturn false\n}\n\nfunc main() {\n\tvar sequence string\n\tvar L int\n\n\tfmt.Scan(&sequence)\n\tfmt.Scan(&L)\n\n\tseq := []byte(sequence)\n\n\tvalido(seq, 0, L)\n\n\tfmt.Println(string(seq))\n}\n",
            "lines": "59"
